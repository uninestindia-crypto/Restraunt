# Supabase Cloud Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Staff cloud sessions are created inside Settings and passwords are never stored in frontend env files.

# Admin recovery script configuration.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side only. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORE_ID=the-taste
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_PIN=replace-with-secure-4-digit-pin
ADMIN_NAME=Owner
