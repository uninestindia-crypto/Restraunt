# ═══════════════════════════════════════════════════
#  NextGenOS Restaurant Operating System
#  Environment Variables Configuration Template
# ═══════════════════════════════════════════════════

# 1. Supabase Cloud Database Sync Configuration
# Replace these values with your actual Supabase URL and Anon Public Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Local POS Settings Default Key (Optional)
# This will be used as a fallback if keys are not configured via Settings UI
VITE_DEFAULT_ORDER_PREFIX=TT
